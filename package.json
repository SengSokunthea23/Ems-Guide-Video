{
  "name": "ems-guide-video",
  "version": "1.0.0",
  "description": "EMS step-by-step guide video (Remotion + React + TypeScript), 1920x1080, 30 fps, 167.83 s",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts EMS-Navy-Landscape out/EMS_Guide.mp4",
    "still": "remotion still src/index.ts EMS-Navy-Landscape out/still.png --frame=1350",
    "typecheck": "tsc --noEmit",
    "music": "python3 music.py",
    "shots": "node scripts/prepare-shots.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "@remotion/renderer": "4.0.250",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.250",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  },
  "private": true
}
